rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNCIONES DE SEGURIDAD Y CONTROL DE ACCESO POR ROLES (RBAC)
    // ============================================================

    // Verifica que el usuario tenga una sesión activa y válida en Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtiene el rol del usuario desde su documento en /usuarios/{uid}
    function getUserRole() {
      return request.auth.token.email == 'admin@donbrasa.pe' ? 'admin' :
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ?
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role : 'mozo';
    }

    // Comprobaciones de roles específicos
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.email == 'admin@donbrasa.pe' || getUserRole() == 'admin');
    }

    function isMozo() {
      return isAuthenticated() && (getUserRole() == 'mozo' || isAdmin());
    }

    function isCocina() {
      return isAuthenticated() && (getUserRole() == 'cocina' || isAdmin());
    }

    function isCajero() {
      return isAuthenticated() && (getUserRole() == 'cajero' || isAdmin());
    }

    // ============================================================
    // REGLAS POR COLECCIÓN
    // ============================================================

    // 1. Perfiles de Usuarios y Protección de Roles
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      // Un usuario solo puede crear su propio perfil y NO puede auto-asignarse rol admin a menos que sea el correo oficial
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (request.resource.data.role != 'admin' || request.auth.token.email == 'admin@donbrasa.pe');
      // Solo administradores pueden cambiar roles de otros usuarios; un usuario común no puede modificar su propio rol
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // 2. Mesas de Salón
    match /mesas/{mesaId} {
      allow read: if isAuthenticated();
      // Mozos y administradores abren mesas; cajeros liberan mesas
      allow create: if isMozo();
      allow update: if isMozo() || isCajero();
      allow delete: if isAdmin();
    }

    // 3. Catálogo de Platos y Categorías (Carta Oficial)
    // Todo el personal puede consultar la carta; SOLO administradores pueden modificar precios o platos
    match /categorias/{categoriaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /productos/{productoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Atenciones de Mesa (Cuentas en Sala)
    match /atenciones/{atencionId} {
      allow read: if isAuthenticated();
      allow create: if isMozo();
      allow update: if isMozo() || isCajero();
      allow delete: if isAdmin();
    }

    // 5. Comandas de Cocina
    match /comandas/{comandaId} {
      allow read: if isAuthenticated();
      allow create: if isMozo();
      allow update: if isCocina() || isMozo();
      allow delete: if isAdmin();
    }

    // 6. Registro de Pagos y Liquidaciones
    match /pagos/{pagoId} {
      allow read: if isCajero() || isAdmin();
      allow create: if isCajero() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // 7. Colección de Diagnóstico / Verificación
    match /diagnostico/{docId} {
      allow read, write: if isAuthenticated();
    }

    // 8. BLOQUEO TOTAL POR DEFECTO: Denegar cualquier acceso no autorizado o público
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
