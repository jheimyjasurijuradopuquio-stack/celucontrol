rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function role() {
      return userExists()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isMozo() {
      return signedIn() && (role() == 'mozo' || isAdmin());
    }

    function isCocina() {
      return signedIn() && (role() == 'cocina' || isAdmin());
    }

    function isCajero() {
      return signedIn() && (role() == 'cajero' || isAdmin());
    }

    match /usuarios/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'mozo';

      allow update: if isAdmin() ||
        (signedIn() &&
         request.auth.uid == userId &&
         request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    match /mesas/{id} {
      allow read: if signedIn();
      allow create: if isMozo() || isAdmin();
      allow update: if isMozo() || isCajero() || isAdmin();
      allow delete: if isAdmin();
    }

    match /categorias/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /productos/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /atenciones/{id} {
      allow read: if signedIn();
      allow create: if isMozo() || isCajero() || isAdmin();
      allow update: if isMozo() || isCajero() || isAdmin();
      allow delete: if isAdmin();
    }

    match /comandas/{id} {
      allow read: if signedIn();
      allow create: if isMozo() || isCajero() || isAdmin();
      allow update: if isCocina() || isMozo() || isCajero() || isAdmin();
      allow delete: if isAdmin();
    }

    match /pagos/{id} {
      allow read, create: if isCajero() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /diagnostico/{id} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
